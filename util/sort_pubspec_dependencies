#!/bin/bash

if [ ! -f util/.serverpod_util_root ]; then
    echo "Run this script from the root of the Serverpod repository"
    echo "I.e. util/sort_pubspec_dependencies"
    exit 1
fi

# Makes script exit on first non-zero error code
set -e

echo "Sort all pubspecs dependencies"

# One `dart run` for the whole tree. Parallel `dart run` from the workspace
# root races on member pubspecs — see util/sort_pubspec_dependencies.dart.
dart run util/sort_pubspec_dependencies.dart
