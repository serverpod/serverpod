#!/bin/bash

# Runs `dart analyze` over the packages that are not members of the pub
# workspace, which `melos exec` cannot reach. See util/non_workspace_packages.
#
# Any arguments are passed straight through to `dart analyze`, so the melos
# `lint`, `lint_loose` and `lint_strict` scripts can each supply their own
# severity flags.

if [ ! -f util/.serverpod_util_root ]; then
    echo "Run this script from the root of the Serverpod repository"
    echo "I.e. util/analyze_non_workspace --fatal-warnings"
    exit 1
fi

. "util/non_workspace_packages"

util/pub_get_non_workspace || exit 1

exit_code=0

echo "### Running dart analyze $* on non-workspace packages"
for pkg in "${NON_WORKSPACE_PACKAGE_PATHS[@]}"
do
    dart analyze "$@" "$pkg" || exit_code=1
done

exit $exit_code
