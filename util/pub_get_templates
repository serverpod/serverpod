#!/bin/bash

# Resolves the template packages listed in util/template_packages, which are not
# members of the pub workspace and pin the version currently in development.
#
# For each one it writes a `pubspec_overrides.yaml` mapping every Serverpod
# dependency to its local path, so the template resolves against the repository
# instead of pub.dev. The file is gitignored, regenerated on every run, and
# skipped by the create Copier, so it never reaches a created project.
#
# Run by the `melos bootstrap` post hook and by the CI job that resolves the
# templates before `util/generate_templates`, so a clean checkout works the same
# way as a bootstrapped machine.

if [ ! -f util/.serverpod_util_root ]; then
    echo "Run this script from the root of the Serverpod repository"
    echo "I.e. util/pub_get_templates"
    exit 1
fi

. "util/template_packages"

# Maps every local package name to its path, as "name<TAB>path" lines.
local_packages() {
    find packages modules integrations tools -name pubspec.yaml \
        -not -path '*/.dart_tool/*' -not -path '*/test/*' -not -path '*/build/*' |
    while read -r pubspec; do
        name=$(sed -n 's/^name:[[:space:]]*//p' "$pubspec" | head -n 1)
        [ -n "$name" ] && printf '%s\t%s\n' "$name" "$(dirname "$pubspec")"
    done
}

# Prints the dependency names declared by a pubspec, across `dependencies` and
# `dev_dependencies`. Entries are two-space indented keys inside those blocks.
declared_dependencies() {
    awk '
        /^(dependencies|dev_dependencies):/ { in_deps = 1; next }
        /^[^[:space:]#]/ { in_deps = 0 }
        in_deps && /^  [a-zA-Z_][a-zA-Z0-9_]*:/ {
            sub(/:.*/, "", $1); print $1
        }
    ' "$1"
}

PACKAGE_MAP=$(local_packages)

path_of() {
    printf '%s\n' "$PACKAGE_MAP" | awk -F'\t' -v n="$1" '$1 == n { print $2; exit }'
}

# Walks the dependency graph from a template pubspec and prints every local
# package it reaches, transitively.
resolve_closure() {
    local pending seen name path dep
    pending=$(declared_dependencies "$1")
    seen=""

    while [ -n "$pending" ]; do
        name=$(printf '%s\n' "$pending" | head -n 1)
        pending=$(printf '%s\n' "$pending" | tail -n +2)

        case " $seen " in *" $name "*) continue ;; esac

        path=$(path_of "$name")
        [ -z "$path" ] && continue

        seen="$seen $name"
        for dep in $(declared_dependencies "$path/pubspec.yaml"); do
            case " $seen " in *" $dep "*) continue ;; esac
            pending=$(printf '%s\n%s\n' "$pending" "$dep")
        done
    done

    for name in $seen; do
        printf '%s\t%s\n' "$name" "$(path_of "$name")"
    done | sort
}

write_overrides() {
    local pkg=$1 overrides prefix segment
    overrides=$(resolve_closure "$pkg/pubspec.yaml")

    if [ -z "$overrides" ]; then
        rm -f "$pkg/pubspec_overrides.yaml"
        return
    fi

    # Path overrides are relative to the template, so climb out of it first.
    prefix=""
    for segment in $(printf '%s\n' "$pkg" | tr '/' ' '); do
        prefix="$prefix../"
    done

    {
        echo "# Generated by util/pub_get_templates. Do not edit or commit."
        echo "dependency_overrides:"
        printf '%s\n' "$overrides" | while IFS=$'\t' read -r name path; do
            echo "  $name:"
            echo "    path: $prefix$path"
        done
    } > "$pkg/pubspec_overrides.yaml"
}

exit_code=0

echo "Resolving template packages..."
for pkg in "${TEMPLATE_PACKAGE_PATHS[@]}"
do
    echo "  └> $pkg"

    write_overrides "$pkg"

    if ! output=$(cd "$pkg" && dart pub get 2>&1); then
        echo "$output"
        exit_code=1
    fi
done

if [ $exit_code != 0 ]; then
    echo "[!] Failed to resolve one or more template packages."
fi

echo ""
exit $exit_code
